{
  "manifest_version": 3,
  "name": "TechHub Profile Sync",
  "version": "1.0.0",
  "description": "Chrome Extension để đồng bộ thông tin profile từ TechHub với Supabase",
  "permissions": ["storage", "webRequest", "activeTab", "tabs", "scripting", "alarms", "sidePanel", "declarativeNetRequest", "notifications"],
  "host_permissions": ["https://techhub.fpt.net/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/coin.png",
      "48": "icons/coin.png",
      "128": "icons/coin.png"
    },
    "default_title": "Mở TechHub Profile Sync"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/coin.png",
    "48": "icons/coin.png",
    "128": "icons/coin.png"
  }
}

{
  "manifest_version": 3,
  "name": "TechHub Push Admin",
  "version": "1.1.1",
  "description": "Admin tool để push bài (is_ultra) và chỉnh ngưỡng comment trên Supabase",
  "permissions": ["storage", "webRequest", "activeTab", "tabs", "scripting", "alarms", "sidePanel", "declarativeNetRequest", "notifications", "cookies"],
  "host_permissions": ["https://techhub.fpt.net/*", "https://*.supabase.co/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/coin.png",
      "48": "icons/coin.png",
      "128": "icons/coin.png"
    },
    "default_title": "Mở TechHub Push Admin"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/coin.png",
    "48": "icons/coin.png",
    "128": "icons/coin.png"
  }
}
